olid var(--rule)}.sg-swatch div+div{padding:.4rem .5rem}.sg-swatch code{font-family:var(--mono)}.sg-row{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin:.75rem 0 1.25rem}.sg-type p{margin:.25rem 0}.sg-demo{border:1px dashed var(--rule);padding:1rem;margin:.75rem 0 1.25rem;background:var(--slate)}.sg-demo-window{background:var(--window);border:1px solid #000;border-radius:0 var(--radius)var(--radius)var(--radius);padding:1rem}@media(max-width:760px){.ds-shell{grid-template-columns:1fr;margin-top:.75rem}.ds-rail{position:static;padding:0;overflow-x:auto}.ds-rail ul{display:flex}.ds-rail li{flex:none}.ds-rail a{padding:.55rem .8rem}.ds-rail .ds-host,.ds-rail hr,.ds-rail .ds-rail-extra{display:none}.ds-window{padding:1rem;border-radius:0 0 var(--radius)var(--radius)}.ds-wordmark{font-size:1.6rem}.ds-mark{width:44px;height:44px}.ds-intro{flex-direction:column;align-items:flex-start}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}.gem-hud{position:fixed;top:12px;right:12px;z-index:50;font:.8rem/1 var(--ui)}.gem-btn{display:flex;align-items:center;gap:.4rem;padding:.35rem .7rem .35rem .45rem;border:1px solid var(--rule);border-radius:999px;background:var(--window);color:var(--ink);box-shadow:0 2px 10px rgba(0,0,0,.18);cursor:pointer;font:inherit}.gem-btn:focus-visible{outline:3px solid var(--focus);outline-offset:2px}.gem-float{display:inline-block;width:26px;height:24px;animation:gem-bob 2.6s ease-in-out infinite;filter:drop-shadow(0 0 4px rgba(105,189,62,.55))}.gem-svg{width:100%;height:100%;display:block}.gem-svg .f1{fill:#9be36f}.gem-svg .f2{fill:#2f9a3a}.gem-svg .f3{fill:#d6ffb8}.gem-svg .f4{fill:#69bd3e}.gem-svg .f5{fill:#1f7a2a}.gem-svg .edge{fill:none;stroke:#0b4d12;stroke-width:1.4;stroke-linejoin:round}@keyframes gem-bob{0%,100%{transform:translateY(0)rotate(-4deg)}50%{transform:translateY(-4px)rotate(4deg)}}.gem-total{font:900 1.05rem/1 var(--display);font-variant-numeric:tabular-nums}.gem-mine{font:.72rem/1 var(--mono);color:var(--ink-2)}.gem-pop{position:absolute;top:4px;left:8px;pointer-events:none;font:900 1.6rem/1 var(--display);color:#c8ff7a;-webkit-text-stroke:1.5px #0b2a0e;paint-order:stroke fill;text-shadow:0 3px 0 #0b2a0e}.gem-panel{position:absolute;top:calc(100% + 6px);right:0;width:16rem;max-width:calc(100vw - 24px);padding:.7rem .85rem;background:var(--window);color:var(--ink);border:1px solid var(--rule);border-radius:var(--radius);box-shadow:0 4px 16px rgba(0,0,0,.2);font:.8rem/1.45 var(--ui)}.gem-panel p{margin:0 0 .35rem}.gem-panel p:last-child{margin:0}.gem-panel-head{font-weight:700;color:var(--lime-ink)}.gem-lost{display:block;margin:.4rem 0 0 auto;width:14px;height:13px;padding:0;border:0;background:0 0;opacity:.18;cursor:default}.gem-lost svg{display:block;width:100%;height:100%;fill:currentColor}.gem-lost:hover,.gem-lost:focus-visible{opacity:.6}a.dict-term{text-decoration-style:dotted;text-underline-offset:.15em}.dict-summary{font-size:1.1rem;color:var(--ink-2)}.dict-sources li,.dict-uses li{margin-bottom:.5rem}.dict-pub,.dict-primary,.dict-health,.dict-orig{font:.8rem/1.4 var(--ui);color:var(--ink-2);margin-left:.4rem}.dict-primary{border:1px solid var(--rule);border-radius:3px;padding:0 .3rem}.dict-orig{display:block;margin-left:0}.dict-url{overflow-wrap:anywhere}.dict-healthy .dict-health{color:var(--lime-ink)}.dict-dead .dict-health,.dict-failing .dict-health{color:var(--alert);font-weight:700}.dict-archive{font:.8rem/1.4 var(--ui);margin-left:.4rem}.ds-vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.dict-crumbs ol{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap}.dict-crumbs li+li::before{content:"/";padding:0 .4rem;color:var(--ink-2)}.dict-facets{display:flex;flex-wrap:wrap;gap:.4rem .75rem;align-items:center}.dict-see li,.dict-topic-list li{margin-bottom:.5rem}.dict-topic-desc{display:block;color:var(--ink-2)}.dict-az ul,.dict-topics-inline{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:.25rem .75rem}.dict-az a{display:inline-block;min-width:1.75rem;text-align:center}.ds-search{position:relative;margin-left:auto;flex:0 1 18rem;min-width:12rem}.ds-search input{width:100%;box-sizing:border-box;font:1rem/1.4 var(--ui);padding:.4rem .6rem;border:1px solid var(--rule);border-radius:4px;background:var(--window);color:var(--ink)}.ds-search input:focus-visible{outline:3px solid var(--focus);outline-offset:1px}.ds-search-list{position:absolute;z-index:20;left:0;right:0;top:calc(100% + 2px);margin:0;padding:.25rem 0;list-style:none;max-height:22rem;overflow-y:auto;background:var(--window);border:1px solid var(--rule);border-radius:4px;box-shadow:0 4px 14px rgba(0,0,0,.15)}.ds-search-opt,.ds-search-none{color:var(--ink);padding:.4rem .6rem;cursor:pointer}.ds-search-none{cursor:default;color:var(--ink-2)}.ds-search-opt[aria-selected=true],.ds-search-opt:hover{background:var(--hover)}.ds-search-title{display:block}.ds-search-kind{display:block;font:.8rem/1.4 var(--ui);color:var(--ink-2)}.ds-search-results li{margin-bottom:.9rem}@media(max-width:40rem){.ds-search{flex-basis:100%;margin-left:0}}