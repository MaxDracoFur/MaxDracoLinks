:root{--slate:#525d76;--slate-2:#7c869c;--slate-ink:#ffffff;--window:#ffffff;--panel:#ebebeb;--head:#ccd6df;--rule:#abb7c1;--ink:#111111;--ink-2:#555555;--link:#660a0a;--link-hover:#a3141a;--lime:#69bd3e;--band:#0b7a12;--band-ink:#ffffff;--lime-ink:#2e6e12;--alert:#cc0000;--zebra:#f4f6f8;--hover:#eef7e8;--focus:#ffcc00;--ui:Verdana, Tahoma, "DejaVu Sans", sans-serif;--body:Arial, "Helvetica Neue", Helvetica, sans-serif;--display:"Arial Black", "Helvetica Neue", Arial, sans-serif;--mono:ui-monospace, "SF Mono", Menlo, Consolas, monospace;--radius:10px;color-scheme:light}@media(prefers-color-scheme:dark){:root{--slate:#1c2130;--slate-2:#3a4258;--slate-ink:#e9ecf1;--window:#232835;--panel:#2c3240;--head:#364056;--rule:#4b5568;--ink:#e9ecf1;--ink-2:#aab1bd;--link:#f0a3a3;--link-hover:#ffc4c4;--lime:#7fd055;--band:#1f6b1a;--band-ink:#f2fff0;--lime-ink:#8fdc66;--alert:#ff6b6b;--zebra:#272d3a;--hover:#2d3a2c;color-scheme:dark}}*,*::before,*::after{box-sizing:border-box}html{-webkit-text-size-adjust:100%}body{margin:0;min-height:100vh;background:var(--slate);color:var(--ink);font:16px/1.55 var(--body)}a{color:var(--link);text-underline-offset:.15em}a:hover{color:var(--link-hover)}:focus-visible{outline:3px solid var(--focus);outline-offset:2px}img{max-width:100%;height:auto}.ds-titlebar{max-width:68rem;margin:0 auto;padding:1rem 16px .75rem;display:flex;align-items:center;gap:.75rem 1.5rem;flex-wrap:wrap;color:var(--slate-ink)}.ds-brand{display:flex;align-items:center;gap:.6rem;color:var(--slate-ink);text-decoration:none}.ds-brand:hover{color:var(--slate-ink)}.ds-mark{width:56px;height:56px;flex:none;border-radius:50%;object-fit:cover;border:3px solid #111;background:#fff}.ds-wordmark{font:italic 900 2rem/1 var(--display);letter-spacing:-.03em}.ds-wordmark .ds-sub{color:var(--lime)}.ds-band{background:var(--band);color:var(--band-ink);font:700 .8rem/1.4 var(--ui);border-top:1px solid rgba(255,255,255,.25);border-bottom:1px solid rgba(0,0,0,.35)}.ds-band-inner{max-width:68re